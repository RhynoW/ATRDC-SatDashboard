{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SatDashboard StoryMap story",
  "type": "object",
  "required": [
    "id",
    "title",
    "sections"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "hero_note": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "title"
        ],
        "properties": {
          "type": {
            "enum": [
              "text",
              "toc",
              "table",
              "sat",
              "positions",
              "embed",
              "groupstats",
              "isrres",
              "maneuvers",
              "radar",
              "skyplot",
              "cdm",
              "reentry"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "dur": {
            "type": "number",
            "minimum": 0
          },
          "body": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "all",
              "country",
              "constellation",
              "purpose",
              "group",
              "ids"
            ]
          },
          "val": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999
            }
          },
          "norads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999
            }
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "group": {
            "enum": [
              "gps",
              "beidou",
              "starlink",
              "oneweb",
              "prc_isr",
              "prc_comm"
            ]
          },
          "groups": {
            "type": "array",
            "items": {
              "enum": [
                "gps",
                "beidou",
                "starlink",
                "oneweb",
                "prc_isr",
                "prc_comm"
              ]
            }
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "threshold_km": {
            "type": "number",
            "minimum": 1,
            "maximum": 500
          },
          "url": {
            "type": "string",
            "pattern": "^/"
          },
          "height": {
            "type": "integer",
            "minimum": 200
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array"
            }
          },
          "row_anchors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "anchor"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "table"
                }
              }
            },
            "then": {
              "required": [
                "columns",
                "rows"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "sat"
                }
              }
            },
            "then": {
              "required": [
                "norads"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "embed"
                }
              }
            },
            "then": {
              "required": [
                "url"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "toc"
                }
              }
            },
            "then": {
              "required": [
                "items"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "positions"
                },
                "mode": {
                  "const": "ids"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "ids"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "groupstats",
                    "isrres",
                    "radar",
                    "skyplot"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "group"
              ]
            }
          }
        ]
      }
    }
  }
}